generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id              String   @id @default(uuid())
  amount          Int      // Total in lowest denomination (e.g. Halalas/Cents)
  status          String   @default("PENDING") // PENDING, PAID, FAILED
  items           Json     // Store cart items snapshot
  customerEmail   String?
  customerName    String?
  stripeSessionId String?  @unique // Idempotency key & lookup
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
